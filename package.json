{
  "name": "@nuxtjs/partytown",
  "version": "2.0.0",
  "license": "MIT",
  "author": {
    "name": "Daniel Roe <daniel@roe.dev>",
    "url": "https://github.com/danielroe"
  },
  "exports": {
    ".": "./dist/module.mjs"
  },
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nuxt dev playground",
    "dev:v5": "pnpm --filter partytown-module-playground-v5 dev",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground && pnpm --filter partytown-module-playground-v5 exec nuxt prepare",
    "prepack": "pnpm build",
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "release": "bumpp && npm publish"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.0",
    "@qwik.dev/partytown": "^1.0.0",
    "knitwork": "^1.2.0",
    "serve-static": "^2.0.0",
    "ufo": "^1.5.4"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.6.2",
    "@nuxt/test-utils": "4.3.3",
    "@types/serve-static": "2.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "bumpp": "12.3.0",
    "eslint": "10.12.0",
    "nuxt": "4.6.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue": "3.5.44"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
